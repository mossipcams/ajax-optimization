#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

from training_paths import configure

configure()

ROOT = Path(__file__).resolve().parent
PYTHON = Path(os.environ.get("PYTHON", ROOT / "training/.venv/bin/python"))
STATE = ROOT / "training/runs/promotion"
SELECT_TOP_N = 3
CANDIDATES = ROOT / "training/datasets/candidates"
GPU_LOCK = os.environ.get("GPU_LOCK", "/srv/llm/bin/gpu")
GENERATION_CONFIG = "training/configs/generation/full_sft_v7.yaml"
BASE_MODEL = os.environ.get("BASE_MODEL", "/srv/llm/lfm/models/LFM2.5-230M-Base")
DATASET_DIR = Path(os.environ.get("DATASET_DIR", "/srv/llm/data/lfm/datasets"))
EVAL_RESULTS = Path(os.environ.get("EVAL_RESULTS", "/srv/llm/lfm/runs/sayso-promotion"))
HOST = "/workspace/host"
HOST_LFM = "/srv/llm/lfm"
HOST_TRAINING = os.environ.get("SAYSO_TRAINING_HOST_ROOT", f"{HOST}/lfm/ajax-optimization/sayso-training")
os.environ.setdefault("HF_HOME", "/srv/llm/hf-cache")


def run(command: list[str], *, cwd: Path = ROOT) -> None:
    print("+", " ".join(map(str, command)), flush=True)
    subprocess.run(command, cwd=cwd, check=True)


def digest(path: Path) -> str:
    result = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            result.update(chunk)
    return result.hexdigest()


def git_commit() -> str:
    try:
        return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    except (OSError, subprocess.CalledProcessError):
        pass
    try:
        value = (ROOT / "REVISION").read_text(encoding="utf-8").strip()
    except OSError:
        return "unknown"
    if len(value) == 40 and all(ch in "0123456789abcdef" for ch in value):
        return value
    return "unknown"


def save(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    temp.replace(path)


def load(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def host_path(path: str) -> str:
    prefix = f"{HOST}/lfm"
    value = str(path)
    if value == prefix or value.startswith(prefix + "/"):
        return HOST_LFM + value[len(prefix):]
    return value


def container_path(path: str) -> str:
    value = str(path)
    if value == HOST_LFM or value.startswith(HOST_LFM + "/"):
        return f"{HOST}/lfm" + value[len(HOST_LFM):]
    return value

def current() -> dict:
    pointer = STATE / "current.json"
    if not pointer.is_file():
        raise SystemExit("No candidate run. Start with ./sayso generate")
    record = load(STATE / f"{load(pointer)['run_id']}.json")
    if not Path(record["dataset_path"]).is_file():
        raise SystemExit(f"Candidate dataset is missing: {record['dataset_path']}")
    return record


def write_current(record: dict) -> None:
    save(STATE / f"{record['run_id']}.json", record)
    save(STATE / "current.json", {"run_id": record["run_id"]})


def ensure_vm() -> None:
    if not PYTHON.is_file():
        raise SystemExit(f"Missing Python environment: {PYTHON}")
    if not Path(GPU_LOCK).is_file() or not os.access(GPU_LOCK, os.X_OK):
        raise SystemExit(f"Missing VM GPU lock: {GPU_LOCK}; run these commands on the llm VM")


def gpu(action: str) -> None:
    if Path(GPU_LOCK).is_file() and os.access(GPU_LOCK, os.X_OK):
        subprocess.run([GPU_LOCK, action], check=False)


def untrained_promoted() -> bool:
    try:
        promotion = load(STATE / "promoted_dataset.json")
        return not load(STATE / f"{promotion['run_id']}.json").get("trained")
    except (OSError, KeyError, json.JSONDecodeError):
        return False


def settle_gpu() -> None:
    gpu("stop" if untrained_promoted() else "serve")


def render_and_stage(record: dict) -> str:
    rendered = Path(record["rendered_path"])
    run([str(PYTHON), str(ROOT / "training/scripts/export_llamafactory_view.py"), record["dataset_path"],
         "--output", str(rendered), "--dataset-name", f"sayso_{record['run_id']}",
         "--dataset-info-out", str(rendered.with_suffix(".info.json")), "--model", BASE_MODEL])
    DATASET_DIR.mkdir(parents=True, exist_ok=True)
    staged = DATASET_DIR / rendered.name
    shutil.copy2(rendered, staged)
    record["rendered_sha256"] = digest(rendered)
    record["staged_data"] = f"{HOST}/datasets/{staged.name}"
    return record["staged_data"]


def eval_checkpoint(checkpoint: str, out_name: str, suite: str, profile: str | None = None) -> tuple[bool, dict]:
    out_name = f"{out_name}-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    out = f"{HOST}/lfm/runs/sayso-promotion/{out_name}"
    results = EVAL_RESULTS / out_name
    cmd = ["docker", "exec", "-e", "CUDA_VISIBLE_DEVICES=", "-e", "HIP_VISIBLE_DEVICES=",
           "-w", HOST_TRAINING, "unsloth", "bash", "-c",
           'source ./env.sh && exec python "$@"', "sayso-eval",
           f"{HOST_TRAINING}/training/scripts/eval_checkpoint_cpu.py", checkpoint,
           "--suite", suite, "--out", out]
    if profile:
        cmd.extend(("--profile", profile))
    if suite == "smoke":
        for tag in ("recipe-lock", "gold", "shadow", "grounding", "context"):
            cmd.extend(("--tag", tag))
    result = subprocess.run(cmd, cwd=ROOT)
    summaries: dict[str, dict] = {}
    for summary_path in results.glob("*/summary.json"):
        try:
            metadata = load(summary_path.parent / "metadata.json")
            if metadata.get("checkpoint") == checkpoint:
                summaries[metadata.get("gate_label", summary_path.parent.name)] = load(summary_path)
        except (OSError, json.JSONDecodeError):
            continue
    return result.returncode == 0, summaries


def cmd_generate(_: argparse.Namespace) -> None:
    if not PYTHON.is_file():
        raise SystemExit(f"Missing Python environment: {PYTHON}")
    import yaml
    recipe = yaml.safe_load((ROOT / GENERATION_CONFIG).read_text(encoding="utf-8"))
    paraphrase = bool(recipe.get("generation", {}).get("paraphrase_enabled"))
    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:8]
    CANDIDATES.mkdir(parents=True, exist_ok=True)
    dataset = CANDIDATES / f"{run_id}.jsonl"
    manifest = CANDIDATES / f"{run_id}.manifest.json"
    generator = [str(PYTHON), "-m", "generators.cli", "--config", Path(GENERATION_CONFIG).relative_to("training").as_posix(),
                 "--output", str(dataset), "--manifest", str(manifest)]
    if paraphrase:
        gpu("serve")
        try:
            run(generator, cwd=ROOT / "training")
        finally:
            gpu("stop")
    else:
        run(generator, cwd=ROOT / "training")
    record = {"run_id": run_id, "dataset_path": str(dataset), "manifest_path": str(manifest),
              "rendered_path": str(CANDIDATES / f"{run_id}.rendered.jsonl"), "git_commit": git_commit(),
              "config": GENERATION_CONFIG,
              "config_sha256": digest(ROOT / GENERATION_CONFIG),
              "created_at": datetime.now(timezone.utc).isoformat(),
              "dataset_sha256": digest(dataset), "validated": False, "canary_passed": False,
              "trained": False, "final_eval_passed": False}
    write_current(record)
    print(f"Candidate created: {run_id}\nDataset: {dataset}")


def cmd_validate(_: argparse.Namespace) -> None:
    record = current()
    if digest(Path(record["dataset_path"])) != record["dataset_sha256"]:
        raise SystemExit("Candidate changed since generation; generate a fresh run before validation")
    record.update(validated=False, canary_passed=False)
    write_current(record)
    run([str(PYTHON), str(ROOT / "scripts/preflight.py"), record["dataset_path"]])
    record["validated"] = True
    record["validated_sha256"] = record["dataset_sha256"]
    write_current(record)


def passed_count(summaries: dict | None) -> int:
    return sum(entry.get("summary", {}).get("passed", 0) for entry in (summaries or {}).values())


def rank_candidates(rows: list[dict]) -> list[dict]:
    return sorted(
        rows,
        key=lambda row: (-row["context"], -(row["smoke"] or 0), row["step"]),
    )


def trainer_args() -> list[str]:
    args: list[str] = []
    model_path = os.environ.get("TRAIN_MODEL") or BASE_MODEL
    if os.environ.get("TRAIN_MODEL"):
        args.extend(("--model", container_path(model_path)))
    lr = os.environ.get("TRAIN_LR") or "2e-5"
    args.extend(("--lr", lr))
    if warmup := os.environ.get("TRAIN_WARMUP_RATIO"):
        args.extend(("--warmup-ratio", str(float(warmup))))
    if save_total_limit := os.environ.get("TRAIN_SAVE_TOTAL_LIMIT"):
        args.extend(("--save-total-limit", str(int(save_total_limit))))
    return args


def record_training_fields(record: dict) -> None:
    model_path = os.environ.get("TRAIN_MODEL") or BASE_MODEL
    lr = os.environ.get("TRAIN_LR") or "2e-5"
    record["learning_rate"] = float(lr)
    if os.environ.get("TRAIN_MODEL"):
        record["model_path"] = model_path
        weights = Path(host_path(model_path)) / "model.safetensors"
        if not weights.is_file():
            raise SystemExit(f"Training model weights missing on host: {weights}")
        record["model_sha256"] = digest(weights)


def cmd_canary(args: argparse.Namespace) -> None:
    record = current()
    if not record.get("validated") or record.get("validated_sha256") != digest(Path(record["dataset_path"])):
        raise SystemExit("Candidate must pass ./sayso validate after its last change")
    ensure_vm()
    record_training_fields(record)
    record["canary_passed"] = False
    write_current(record)
    data = render_and_stage(record)
    run_id = record["run_id"]
    out = f"{HOST}/lfm/runs/sayso-promotion/{run_id}-canary"
    checkpoint = f"{out}/final"
    if args.reuse_checkpoint:
        if not (EVAL_RESULTS / f"{run_id}-canary" / "final").is_dir():
            raise SystemExit(f"No canary checkpoint to reuse: {checkpoint}")
    else:
        try:
            run([GPU_LOCK, "train", "lfm", "python", f"{HOST_TRAINING}/training/scripts/train_unsloth_full.py",
                 "--data", data, *trainer_args(), "--canary", "--out", out])
        finally:
            settle_gpu()
    passed, metrics = eval_checkpoint(checkpoint, f"{run_id}-canary-eval", "smoke", "canary")
    record.update(rendered_sha256=digest(Path(record["rendered_path"])), canary_checkpoint=checkpoint,
                  canary_metrics=metrics, canary_passed=passed)
    write_current(record)
    if not passed:
        raise SystemExit("Canary evaluation failed; dataset remains a candidate")


def cmd_promote_dataset(_: argparse.Namespace) -> None:
    record = current()
    if not record.get("validated") or record.get("validated_sha256") != digest(Path(record["dataset_path"])):
        raise SystemExit("Dataset promotion requires passing validation for the unchanged candidate")
    if not record.get("canary_passed"):
        raise SystemExit("Dataset promotion requires a passing canary evaluation")
    promotion = {"promoted": True, "validation_passed": True, "canary_passed": True,
                 "run_id": record["run_id"], "dataset_path": record["dataset_path"],
                 "dataset_sha256": record["dataset_sha256"], "rendered_sha256": record["rendered_sha256"],
                 "staged_data": record["staged_data"], "git_commit": record["git_commit"],
                 "config": record["config"], "canary_metrics": record["canary_metrics"],
                 "promoted_at": datetime.now(timezone.utc).isoformat()}
    save(STATE / "promoted_dataset.json", promotion)
    record["dataset_promoted"] = True
    write_current(record)
    print(f"Promoted dataset: {record['run_id']}")


def cmd_train(_: argparse.Namespace) -> None:
    promotion_path = STATE / "promoted_dataset.json"
    if not promotion_path.is_file():
        raise SystemExit("Full training blocked: explicitly promote a validated, canary-passing dataset first")
    promotion = load(promotion_path)
    if not all(promotion.get(key) for key in ("promoted", "validation_passed", "canary_passed")):
        raise SystemExit("Full training blocked: promotion record is invalid")
    record_path = STATE / f"{promotion['run_id']}.json"
    record = load(record_path)
    if promotion["dataset_sha256"] != digest(Path(record["dataset_path"])):
        raise SystemExit("Full training blocked: promoted dataset changed after promotion")
    ensure_vm()
    record_training_fields(record)
    write_current(record)
    data = render_and_stage(record)
    if digest(Path(record["rendered_path"])) != promotion["rendered_sha256"]:
        raise SystemExit("Rendered dataset changed after promotion; promote the dataset again")
    out = f"{HOST}/lfm/runs/sayso-promotion/{record['run_id']}-full"
    record.update(trained=False, final_eval_passed=False)
    write_current(record)
    try:
        run([GPU_LOCK, "train", "lfm", "python", f"{HOST_TRAINING}/training/scripts/train_unsloth_full.py",
             "--data", data, *trainer_args(), "--out", out, "--promotion-record", f"{HOST_TRAINING}/training/runs/promotion/promoted_dataset.json"])
    except BaseException:
        settle_gpu()
        raise
    record.update(trained=True, checkpoint=f"{out}/final", full_output=out, final_eval_passed=False)
    write_current(record)
    settle_gpu()




def find_candidates(out_dir: Path) -> list[tuple[int, str]]:
    steps: list[tuple[int, str]] = []
    for path in sorted(out_dir.glob("checkpoint-*"), key=lambda p: int(p.name.rsplit("-", 1)[1])):
        steps.append((int(path.name.rsplit("-", 1)[1]), container_path(path)))
    final = out_dir / "final"
    if final.is_dir():
        steps.append((float("inf"), container_path(final)))
    return steps
def cmd_select_checkpoint(_: argparse.Namespace) -> None:
    record = current()
    if not record.get("trained"):
        raise SystemExit("Checkpoint selection requires a completed full training run")
    ensure_vm()
    steps = find_candidates(Path(host_path(record["full_output"])))
    rows: list[dict] = [{"candidate": Path(path).name, "step": step, "path": path,
                         "context": 0, "smoke": None} for step, path in steps]
    run_id = record["run_id"]
    for row in rows:
        _, summaries = eval_checkpoint(row["path"], f"{run_id}-select-{row['candidate']}", "context")
        row["context"] = passed_count(summaries)
    for row in rank_candidates(rows)[:SELECT_TOP_N]:
        _, summaries = eval_checkpoint(row["path"], f"{run_id}-select-{row['candidate']}", "smoke")
        row["smoke"] = passed_count(summaries)
    ranked = rank_candidates(rows)
    table = [{"candidate": row["candidate"],
              "step": "final" if isinstance(row["step"], float) else row["step"],
              "context": row["context"], "smoke": row["smoke"]} for row in ranked]
    save(STATE / f"{run_id}-selection.json", table)
    print(f"{'CANDIDATE':<28} {'STEP':>10} {'CONTEXT':>9} {'SMOKE':>7}")
    for entry in table:
        smoke = "-" if entry["smoke"] is None else str(entry["smoke"])
        print(f"{entry['candidate']:<28} {str(entry['step']):>10} {entry['context']:>9} {smoke:>7}")
    winner_path = ranked[0]["path"]
    record.update(checkpoint=winner_path, selected_checkpoint=winner_path)
    write_current(record)
    print(f"Selected checkpoint: {winner_path}")


def cmd_eval(_: argparse.Namespace) -> None:
    record = current()
    if not record.get("trained"):
        raise SystemExit("Final eval requires a completed full training run")
    ensure_vm()
    record["final_eval_passed"] = False
    write_current(record)
    metrics: dict[str, dict] = {}
    failed: list[str] = []
    for suite, suffix in (("promotion", "final-eval"), ("context", "final-context")):
        passed, summaries = eval_checkpoint(record["checkpoint"], f"{record['run_id']}-{suffix}", suite)
        metrics.update(summaries)
        if not passed:
            failed.append(suite)
    record.update(final_metrics=metrics, final_eval_passed=not failed)
    write_current(record)
    if failed:
        raise SystemExit(f"Final {', '.join(failed)}-suite evaluation failed; model was not promoted")


def cmd_promote_model(args: argparse.Namespace) -> None:
    record = current()
    if not record.get("trained") or not record.get("final_metrics"):
        raise SystemExit("Model promotion requires a completed final evaluation")
    if args.manual_override and not (args.reason or "").strip():
        raise SystemExit("Manual model promotion requires a non-empty --reason")
    if not record.get("final_eval_passed") and not args.manual_override:
        raise SystemExit("Model promotion requires a passing final evaluation")
    promotion = {"promoted": True, "run_id": record["run_id"],
                 "checkpoint": record["checkpoint"], "dataset_run_id": record["run_id"],
                 "dataset_sha256": record["dataset_sha256"], "git_commit": record["git_commit"],
                 "config": record["config"], "eval_metrics": record["final_metrics"],
                 "final_eval_passed": bool(record["final_eval_passed"]),
                 "promoted_at": datetime.now(timezone.utc).isoformat()}
    if args.manual_override:
        promotion.update(promotion_mode="manual_override", manual_override_reason=args.reason.strip())
    save(STATE / "promoted_model.json", promotion)
    print(f"Promoted model: {record['checkpoint']}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    for name, handler in (("generate", cmd_generate), ("validate", cmd_validate), ("canary", cmd_canary),
                          ("promote-dataset", cmd_promote_dataset), ("train", cmd_train),
                          ("eval", cmd_eval), ("promote-model", cmd_promote_model),
                          ("select-checkpoint", cmd_select_checkpoint)):
        command = sub.add_parser(name)
        if name == "canary":
            command.add_argument("--reuse-checkpoint", action="store_true",
                                 help="skip canary training and evaluate the existing checkpoint")
        if name == "promote-model":
            command.add_argument("--manual-override", action="store_true",
                                 help="promote an evaluated model whose final gates failed")
            command.add_argument("--reason", help="required audit note for a manual override")
    args = parser.parse_args()
    {"generate": cmd_generate, "validate": cmd_validate, "canary": cmd_canary,
     "promote-dataset": cmd_promote_dataset, "train": cmd_train,
     "eval": cmd_eval, "promote-model": cmd_promote_model,
     "select-checkpoint": cmd_select_checkpoint}[args.command](args)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode or 1)
