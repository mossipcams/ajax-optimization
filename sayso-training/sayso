def run(command: list[str], *, cwd: Path = ROOT, env: dict | None = None) -> None:
    print("+", " ".join(map(str, command)), flush=True)
    subprocess.run(command, cwd=cwd, env=env, check=True)


def check_trainer_python() -> None:
    probe = (f"import sys; sys.path.insert(0, '{HOST_TRAINING}/training/scripts'); "
             "import sayso_trainer; sayso_trainer.check_installed_stack()")
    result = subprocess.run(["docker", "exec", "sayso-trainer", TRAINER_PYTHON, "-c", probe],
                            check=False, capture_output=True, text=True)
    if result.returncode != 0:
        tail = "\n".join((result.stdout + result.stderr).strip().splitlines()[-12:])
        raise SystemExit(f"Trainer interpreter {TRAINER_PYTHON} failed the stack check in the sayso-trainer container "
                         f"(exit {result.returncode}):\n{tail}\n"
                         "rebuild it with scripts/llm-host/sayso-trainer-venv.sh")


def current() -> dict:
    pointer = STATE / "current.json"
    if not pointer.is_file():
        raise SystemExit("No candidate run. Start with ./sayso generate")
    record = load(STATE / f"{load(pointer)['run_id']}.json")
    if not Path(record["dataset_path"]).is_file():
        raise SystemExit(f"Candidate dataset is missing: {record['dataset_path']}")
    return record


def write_current(record: dict) -> None:
    save(STATE / f"{record['run_id']}.json", record)
    save(STATE / "current.json", {"run_id": record["run_id"]})


def new_id() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:8]


def save_training(training: dict) -> None:
    save(TRAINS / f"{training['train_id']}.json", training)
    save(STATE / "latest_train.json", {"train_id": training["train_id"]})


def training_run(args: argparse.Namespace) -> dict:
    """The training run an eval/promotion acts on: --train-id, else the latest. Never the newest candidate."""
    train_id = getattr(args, "train_id", None)
    if not train_id:
        pointer = STATE / "latest_train.json"
        if not pointer.is_file():
            raise SystemExit("No training run. Start with ./sayso train")
        train_id = load(pointer)["train_id"]
    path = TRAINS / f"{train_id}.json"
    if not path.is_file():
        raise SystemExit(f"Unknown training run: {train_id}")
    return load(path)


def local_output(training: dict) -> Path:
    return EVAL_RESULTS / Path(training["output"]).name


def host_path(container_path: str) -> Path:
    return LLM_ROOT / Path(container_path).relative_to(HOST)


def model_profile(name: str) -> dict:
    import yaml
    profiles = yaml.safe_load(MODELS.read_text(encoding="utf-8"))["models"]
    if name not in profiles:
        raise SystemExit(f"Unknown model profile {name!r}; valid profiles: {', '.join(profiles)}")
    return profiles[name]


def train_recipe(name: str) -> list[str]:
    profile = model_profile(name)
    return ["--model", profile["trainer_model"], "--lr", str(profile["lr"]),
            "--warmup-ratio", str(profile["warmup_ratio"]), "--batch", str(profile["batch"]),
            "--accum", str(profile["accum"]), *profile["extra_args"]]


def record_profile(record: dict) -> str:
    return record.get("canary_profile") or DEFAULT_MODEL


def git(*args: str, cwd: Path) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def ensure_pinned(root: Path = ROOT, sayso: Path = SAYSO) -> dict:
    """Refuse to train on code that can't be checked out again: tracked edits or an unpushed SaySo commit."""
    status = git("status", "--porcelain", "--untracked-files=no", cwd=root)
    if status.returncode:
        raise SystemExit("Full training needs a git checkout so the code can be pinned")
    if status.stdout.strip():
        raise SystemExit(f"Full training blocked: commit or discard tracked changes first\n{status.stdout}")
    commit = git("rev-parse", "HEAD", cwd=sayso).stdout.strip()
    toplevel = git("rev-parse", "--show-toplevel", cwd=root).stdout.strip()
    key = f"submodule.{sayso.resolve().relative_to(Path(toplevel).resolve()).as_posix()}.url"
    url = git("config", "--file", ".gitmodules", "--get", key, cwd=Path(toplevel)).stdout.strip()
    # Fetch the real remote's branches: a submodule "origin" can be another local checkout,
    # which is how an unpushed eval commit got pinned before.
    fetched = git("fetch", "--quiet", url, "+refs/heads/*:refs/sayso-pin/*", cwd=sayso) if url else None
    contains = git("for-each-ref", "--contains", commit, "refs/sayso-pin", cwd=sayso).stdout.strip()
    if not fetched or fetched.returncode or not contains:
        raise SystemExit(f"Full training blocked: SaySo {commit[:12]} is not on {url or 'its remote'}; push it first")
    return {"git_commit": git("rev-parse", "HEAD", cwd=root).stdout.strip(), "sayso_commit": commit}


def ensure_vm() -> None:
    if not PYTHON.is_file():
        raise SystemExit(f"Missing Python environment: {PYTHON}")
    if not Path(GPU_LOCK).is_file() or not os.access(GPU_LOCK, os.X_OK):
        raise SystemExit(f"Missing VM GPU lock: {GPU_LOCK}; run these commands on the llm VM")


def gpu(action: str) -> None:
    if Path(GPU_LOCK).is_file() and os.access(GPU_LOCK, os.X_OK):
        subprocess.run([GPU_LOCK, action], check=False)


def untrained_promoted() -> bool:
    try:
        promotion = load(STATE / "promoted_dataset.json")
        return not load(STATE / f"{promotion['run_id']}.json").get("trained")
    except (OSError, KeyError, json.JSONDecodeError):
        return False


def settle_gpu() -> None:
    gpu("stop" if untrained_promoted() else "serve")


def render_and_stage(record: dict) -> str:
    """Hold out whole scenario groups for validation loss, then render and stage both splits."""
    rendered = Path(record["rendered_path"])
    split_dir = rendered.with_suffix(".split")
    run([str(PYTHON), str(ROOT / "training/scripts/split_dataset.py"), record["dataset_path"],
         "--out-dir", str(split_dir), "--train-ratio", str(1 - VAL_RATIO), "--val-ratio", str(VAL_RATIO)])
    DATASET_DIR.mkdir(parents=True, exist_ok=True)
    for split, out in (("train", rendered), ("val", rendered.with_suffix(".val.jsonl"))):
        run([str(PYTHON), str(ROOT / "training/scripts/export_llamafactory_view.py"), str(split_dir / f"sayso_{split}.jsonl"),
             "--output", str(out), "--dataset-name", f"sayso_{record['run_id']}_{split}",
             "--dataset-info-out", str(out.with_suffix(".info.json")),
             "--model", str(host_path(model_profile(record_profile(record))["trainer_model"]))])
        shutil.copy2(out, DATASET_DIR / out.name)
    record["rendered_sha256"] = digest(rendered)
    record["staged_data"] = f"{HOST}/datasets/{rendered.name}"
    record["staged_eval_data"] = f"{HOST}/datasets/{rendered.with_suffix('.val.jsonl').name}"
    return record["staged_data"]


def eval_data_args(record: dict) -> list[str]:
    return ["--eval-data", record["staged_eval_data"]] if record.get("staged_eval_data") else []


def eval_checkpoint(checkpoint: str, out_name: str, suite: str, profile: str | None = None) -> tuple[bool, dict]:
    """HF checkpoints score in the trainer container (FP32); host-side GGUFs score through llama-cpp-python."""
    out_name = f"{out_name}-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    results = EVAL_RESULTS / out_name
    if checkpoint.endswith(".gguf"):
        cmd = [str(PYTHON), str(ROOT / "training/scripts/eval_checkpoint_cpu.py"), checkpoint,
               "--suite", suite, "--out", str(results)]
    else:
        cmd = ["docker", "exec", "-e", "CUDA_VISIBLE_DEVICES=", "-e", "HIP_VISIBLE_DEVICES=",
               "-w", HOST_TRAINING, "sayso-trainer", "bash", "-c",
               'source ./env.sh && exec python "$@"', "sayso-eval",
               f"{HOST_TRAINING}/training/scripts/eval_checkpoint_cpu.py", checkpoint,
               "--suite", suite, "--out", f"{HOST}/lfm/runs/sayso-promotion/{out_name}"]
    if profile:
        cmd.extend(("--profile", profile))
    result = subprocess.run(cmd, cwd=ROOT)
    summaries: dict[str, dict] = {}
    for summary_path in results.glob("*/summary.json"):
        try:
            metadata = load(summary_path.parent / "metadata.json")
            if metadata.get("checkpoint") == checkpoint:
                summaries[metadata.get("gate_label", summary_path.parent.name)] = {
                    **load(summary_path), "result_dir": str(summary_path.parent),
                    "runtime": metadata.get("runtime")}
        except (OSError, json.JSONDecodeError):
            continue
    return result.returncode == 0, summaries


def suite_summary(summaries: dict, suite: str) -> dict:
    if suite not in summaries:
        raise SystemExit(f"{suite} evaluation produced no results")
    return summaries[suite]


def outcomes(summary: dict) -> list[dict]:
    with (Path(summary["result_dir"]) / "outcomes.jsonl").open(encoding="utf-8") as stream:
        return [json.loads(line) for line in stream if line.strip()]


def safety_flags() -> set[str]:
    import yaml
    gates = yaml.safe_load((ROOT / "evals/config/gates.yaml").read_text(encoding="utf-8"))
    return set(gates["suites"]["promotion"]["zero_tolerance_flags"])


def step(name: str) -> float:
    return math.inf if name == "final" else int(name.rsplit("-", 1)[1])


def select_checkpoint(table: dict[str, dict]) -> str:
    """Fewest safety flags, then highest promotion pass rate, then highest held-out pass rate, then the earliest step."""
    return min(table, key=lambda name: (table[name]["safety_flags"], -table[name]["pass_rate"],
                                        -table[name].get("heldout_pass_rate", 0.0), step(name)))


def mid_checkpoint(training: dict, names: list[str]) -> str:
    max_steps = (training.get("manifest") or {}).get("max_steps")
    if not max_steps:
        return max(names, key=step)
    target = MID_CHECKPOINT_FRACTION * max_steps
    return min(names, key=lambda name: (abs(step(name) - target), step(name)))


def eval_heldout(training: dict, checkpoint: str, name: str) -> dict:
    view = load(STATE / f"{training['dataset_run_id']}.json").get("staged_eval_data")
    if not view:
        raise SystemExit(f"No staged held-out split for dataset run {training['dataset_run_id']}")
    out_name = f"{training['train_id']}-heldout-{name}"
    results = EVAL_RESULTS / out_name
    results.mkdir(parents=True, exist_ok=True)
    (results / "summary.json").unlink(missing_ok=True)
    subprocess.run(["docker", "exec", "-e", "CUDA_VISIBLE_DEVICES=", "-e", "HIP_VISIBLE_DEVICES=",
                    "-w", HOST_TRAINING, "sayso-trainer", "bash", "-c", 'source ./env.sh && exec python "$@"',
                    "sayso-heldout", f"{HOST_TRAINING}/training/scripts/eval_rendered_cpu.py", checkpoint, view,
                    "--limit", str(HELDOUT_LIMIT), "--out", f"{HOST}/lfm/runs/sayso-promotion/{out_name}/summary.json"],
                   cwd=ROOT)
    summary_path = results / "summary.json"
    if not summary_path.is_file():
        raise SystemExit(f"Held-out evaluation produced no summary: {summary_path}")
    summary = load(summary_path)
    return {"passed": summary["passed"], "total": summary["total"], "pass_rate": summary["pass_rate"],
            "result_dir": str(results)}


def score_checkpoint(training: dict, name: str, safety: set[str]) -> tuple[dict, dict]:
    checkpoint = f"{training['output']}/{name}"
    _, summaries = eval_checkpoint(checkpoint, f"{training['train_id']}-auto-{name}", "promotion")
    promotion = suite_summary(summaries, "promotion")
    heldout = eval_heldout(training, checkpoint, name)
    flags = promotion["summary"]["flags"]
    row = {"promotion_pass_rate": promotion["summary"]["overall_pass_rate"],
           "promotion_passed": promotion["summary"]["passed"], "promotion_total": promotion["summary"]["total"],
           "safety_flags": sum(flags.get(flag, 0) for flag in safety),
           "heldout_pass_rate": heldout["pass_rate"], "heldout_total": heldout["total"],
           "result_dirs": {"promotion": promotion["result_dir"], "heldout": heldout["result_dir"]}}
    return row, {"promotion_flags": flags}


def auto_eval(training: dict) -> None:
    directory = local_output(training)
    rows: dict[str, dict] = {}
    details: dict[str, dict] = {}
    try:
        names = sorted((path.name for path in directory.glob("checkpoint-*")), key=step)
        if not names:
            raise SystemExit(f"No saved checkpoints to evaluate in {directory}")
        safety = safety_flags()
        for name in (mid_checkpoint(training, names), "final"):
            rows[name], details[name] = score_checkpoint(training, name, safety)
            row = rows[name]
            print(f"{name}: promotion {row['promotion_passed']}/{row['promotion_total']} "
                  f"({row['promotion_pass_rate']:.4f}), safety flags {row['safety_flags']}, "
                  f"held-out {row['heldout_pass_rate']:.4f}", flush=True)
    except (Exception, SystemExit) as exc:
        training.update(failure={"stage": "auto_eval", "reason": str(exc)})
        save_training(training)
        raise
    best = select_checkpoint({name: {"safety_flags": row["safety_flags"], "pass_rate": row["promotion_pass_rate"],
                                     "heldout_pass_rate": row["heldout_pass_rate"]} for name, row in rows.items()})
    selected = f"{training['output']}/{best}"
    training.update(auto_eval=rows, selected_checkpoint=selected, release=None, final_metrics=None,
                    final_eval_passed=False, failure=None)
    save_training(training)
    save(directory / "report.json", {"train_id": training["train_id"], "profile": training.get("profile"),
                                     "dataset_run_id": training["dataset_run_id"], "auto_eval": rows,
                                     "selected_checkpoint": selected, "checkpoints": details})
    print(f"Selected: {best}", flush=True)


def row_flags(row: dict) -> set[str]:
    flags = set(row.get("flags") or ())
    if row.get("passed") and row.get("outcome") == "malformed_output":
        flags.add("malformed_treated_as_abstention")
    return flags


def sign_test_p(wins: int, losses: int) -> float:
    n = wins + losses
    if not n:
        return 1.0
    return min(1.0, 2 * sum(math.comb(n, i) for i in range(min(wins, losses) + 1)) / 2 ** n)


def compare_release(candidate: dict[str, list[dict]], champion: dict[str, list[dict]], *,
                    context_passed: bool, safety: set[str], slack: int = RELEASE_SLACK) -> dict:
    """Paired, same-case comparison of a candidate against the deployed champion."""
    report: dict = {"suites": {}, "failures": []}
    failures = report["failures"]
    for suite, rows in candidate.items():
        base = {row["case_id"]: row for row in champion[suite]}
        if set(base) != {row["case_id"] for row in rows}:
            failures.append(f"{suite}: candidate and champion were scored on different cases")
            continue
        wins = sorted(row["case_id"] for row in rows if row["passed"] and not base[row["case_id"]]["passed"])
        losses = sorted(row["case_id"] for row in rows if not row["passed"] and base[row["case_id"]]["passed"])
        new_flags = sorted(f"{row['case_id']}:{flag}" for row in rows
                           for flag in (row_flags(row) - row_flags(base[row["case_id"]])) & safety)
        net: dict[str, int] = {}
        for row in rows:
            delta = int(row["passed"]) - int(base[row["case_id"]]["passed"])
            net[row["category"]] = net.get(row["category"], 0) + delta
        report["suites"][suite] = {
            "total": len(rows), "candidate_passed": sum(row["passed"] for row in rows),
            "champion_passed": sum(row["passed"] for row in base.values()),
            "wins": wins, "losses": losses, "sign_test_p": round(sign_test_p(len(wins), len(losses)), 4),
            "new_safety_flags": new_flags, "category_net": dict(sorted(net.items())),
        }
        if new_flags:
            failures.append(f"{suite}: {len(new_flags)} new safety flag(s) vs champion: {', '.join(new_flags)}")
    promotion = report["suites"].get("promotion")
    if promotion:
        if len(promotion["wins"]) <= len(promotion["losses"]):
            failures.append(f"promotion: {len(promotion['wins'])} wins vs {len(promotion['losses'])} losses "
                            "against the champion; needs more wins than losses")
        failures.extend(f"promotion: category {category} net {delta} vs champion (limit -{slack})"
                        for category, delta in promotion["category_net"].items() if delta < -slack)
    regression = report["suites"].get("regression")
    if regression and len(regression["losses"]) - len(regression["wins"]) > slack:
        failures.append(f"regression: net loss of {len(regression['losses']) - len(regression['wins'])} "
                        f"cases vs champion (limit {slack})")
    if not context_passed:
        failures.append("context: the 100% context gate failed")
    report["passed"] = not failures
    return report


def generate_dataset(checkout: Path, config: str, dataset: Path, manifest: Path) -> None:
    import yaml

    recipe = yaml.safe_load((checkout / config).read_text(encoding="utf-8"))
    generator = [str(PYTHON), "-m", "generators.cli", "--config", str(checkout / config),
                 "--output", str(dataset), "--manifest", str(manifest)]
    env = snapshot_environment(checkout)
    if recipe.get("generation", {}).get("paraphrase_enabled"):
        gpu("serve")
        try:
            run(generator, cwd=checkout / "training", env=env)
        finally:
            gpu("stop")
    else:
        run(generator, cwd=checkout / "training", env=env)


def cmd_generate(args: argparse.Namespace) -> None:
    if not PYTHON.is_file():
        raise SystemExit(f"Missing Python environment: {PYTHON}")
    reason = getattr(args, "accept_drift", None)
    if reason is not None and not reason.strip():
        raise SystemExit("--accept-drift requires a non-empty reason")
    config = Path(getattr(args, "config", GENERATION_CONFIG))
    config = Path(os.path.abspath(ROOT / config)).relative_to(ROOT).as_posix()
    snapshot = snapshot_worktree(ROOT)
    run_id = new_id()
    dataset = CANDIDATES / f"{run_id}.jsonl"
    manifest = CANDIDATES / f"{run_id}.manifest.json"
    gate_changes = check_gate_changes(ROOT, STATE, snapshot, reason, run_id, CANDIDATES)
    with materialize_snapshot(ROOT, snapshot) as checkout:
        gates = check_snapshot(checkout, PYTHON, snapshot, STATE, reason)
        CANDIDATES.mkdir(parents=True, exist_ok=True)
        generate_dataset(checkout, config, dataset, manifest)
        fingerprint = fingerprint_snapshot(checkout, PYTHON, snapshot, config)
    record = {"run_id": run_id, "dataset_path": str(dataset), "manifest_path": str(manifest),
              "rendered_path": str(CANDIDATES / f"{run_id}.rendered.jsonl"),
              "git_commit": snapshot["snapshot_commit"], **snapshot, **gates, **gate_changes,
              "input_fingerprint": fingerprint, "config": config,
              "config_sha256": fingerprint["recipe_sha256"],
              "created_at": datetime.now(timezone.utc).isoformat(),
              "dataset_sha256": digest(dataset), "validated": False, "canary_passed": False,
              "trained": False, "final_eval_passed": False}
    write_current(record)
    print(f"Candidate created: {run_id}\nDataset: {dataset}")


def cmd_validate(_: argparse.Namespace) -> None:
    import yaml
    record = current()
    if digest(Path(record["dataset_path"])) != record["dataset_sha256"]:
        raise SystemExit("Candidate changed since generation; generate a fresh run before validation")
    record.update(validated=False, canary_passed=False)
    write_current(record)
    command = [str(PYTHON), str(ROOT / "scripts/preflight.py"), record["dataset_path"]]
    recipe = yaml.safe_load((ROOT / record["config"]).read_text(encoding="utf-8")) or {}
    preflight_config = recipe.get("preflight")
    if preflight_config:
        command += ["--config", str(ROOT / preflight_config)]
    run(command)
    record["validated"] = True
    record["validated_sha256"] = record["dataset_sha256"]
    write_current(record)


def cmd_canary(args: argparse.Namespace) -> None:
    record = current()
    if not record.get("validated") or record.get("validated_sha256") != digest(Path(record["dataset_path"])):
        raise SystemExit("Candidate must pass ./sayso validate after its last change")
    profile = getattr(args, "model", DEFAULT_MODEL)
    recipe = train_recipe(profile)
    if args.reuse_checkpoint and record_profile(record) != profile:
        raise SystemExit(f"Canary checkpoint was trained with profile {record_profile(record)}; "
                         f"reuse it with --model {record_profile(record)}")
    ensure_vm()
    if not args.reuse_checkpoint:
        check_trainer_python()
    record.update(canary_passed=False, canary_profile=profile, canary_recipe=recipe)
    write_current(record)
    data = render_and_stage(record)
    run_id = record["run_id"]
    out = f"{HOST}/lfm/runs/sayso-promotion/{run_id}-canary"
    checkpoint = f"{out}/final"
    if args.reuse_checkpoint:
        if not (EVAL_RESULTS / f"{run_id}-canary" / "final").is_dir():
            raise SystemExit(f"No canary checkpoint to reuse: {checkpoint}")
    else:
        try:
            run([GPU_LOCK, "train", "lfm", TRAINER_PYTHON, f"{HOST_TRAINING}/training/scripts/sayso_trainer.py",
                 "--data", data, *eval_data_args(record), "--canary", "--out", out, *recipe])
        finally:
            settle_gpu()
    passed, metrics = eval_checkpoint(checkpoint, f"{run_id}-canary-eval", "smoke", "canary")
    manifest = EVAL_RESULTS / f"{run_id}-canary" / "manifest.json"
    schedule = {key: load(manifest).get(key) for key in ("final_step", "max_steps", "last_logged_learning_rate")} \
        if manifest.is_file() else None
    record.update(rendered_sha256=digest(Path(record["rendered_path"])), canary_checkpoint=checkpoint,
                  canary_metrics=metrics, canary_schedule=schedule, canary_passed=passed)
    write_current(record)
    if not passed:
        raise SystemExit("Canary evaluation failed; dataset remains a candidate")


def cmd_promote_dataset(_: argparse.Namespace) -> None:
    record = current()
    if not record.get("snapshot_commit"):
        raise SystemExit("Candidate has no saved snapshot; regenerate with ./sayso generate before promotion")
    if not record.get("validated") or record.get("validated_sha256") != digest(Path(record["dataset_path"])):
        raise SystemExit("Dataset promotion requires passing validation for the unchanged candidate")
    if not record.get("canary_passed"):
        raise SystemExit("Dataset promotion requires a passing canary evaluation")
    if not PYTHON.is_file():
        raise SystemExit(f"Missing Python environment: {PYTHON}")
    with materialize_snapshot(ROOT, record) as checkout, \
            tempfile.TemporaryDirectory(prefix="sayso-reproduce-") as directory:
        dataset = Path(directory) / "dataset.jsonl"
        manifest = Path(directory) / "manifest.json"
        generate_dataset(checkout, record["config"], dataset, manifest)
        candidate_sha256 = digest(Path(record["dataset_path"]))
        reproduced_sha256 = digest(dataset)
        if candidate_sha256 != reproduced_sha256:
            raise SystemExit("Dataset reproduction failed: "
                             f"candidate sha256={candidate_sha256}, regenerated sha256={reproduced_sha256}")
        candidate_hash = load(Path(record["manifest_path"])).get("dataset_hash")
        reproduced_hash = load(manifest).get("dataset_hash")
        if candidate_hash != reproduced_hash:
            raise SystemExit("Dataset reproduction failed: "
                             f"candidate manifest dataset_hash={candidate_hash}, "
                             f"regenerated manifest dataset_hash={reproduced_hash}")
    record.update(reproduced=True, reproduced_sha256=reproduced_sha256,
                  reproduced_at=datetime.now(timezone.utc).isoformat())
    promotion = {"promoted": True, "validation_passed": True, "canary_passed": True,
                 "run_id": record["run_id"], "dataset_path": record["dataset_path"],
                 "dataset_sha256": record["dataset_sha256"], "rendered_sha256": record["rendered_sha256"],
                 "staged_data": record["staged_data"], "git_commit": record["git_commit"],
                 "config": record["config"], "canary_metrics": record["canary_metrics"],
                 "canary_profile": record.get("canary_profile"), "canary_recipe": record.get("canary_recipe"),
                 "promoted_at": datetime.now(timezone.utc).isoformat()}
    save(STATE / "promoted_dataset.json", promotion)
    record["dataset_promoted"] = True
    write_current(record)
    print(f"Promoted dataset: {record['run_id']}")


def cmd_train(args: argparse.Namespace) -> None:
    promotion_path = STATE / "promoted_dataset.json"
    if not promotion_path.is_file():
        raise SystemExit("Full training blocked: explicitly promote a validated, canary-passing dataset first")
    promotion = load(promotion_path)
    if not all(promotion.get(key) for key in ("promoted", "validation_passed", "canary_passed")):
        raise SystemExit("Full training blocked: promotion record is invalid")
    record_path = STATE / f"{promotion['run_id']}.json"
    record = load(record_path)
    if promotion["dataset_sha256"] != digest(Path(record["dataset_path"])):
        raise SystemExit("Full training blocked: promoted dataset changed after promotion")
    profile = getattr(args, "model", DEFAULT_MODEL)
    recipe = train_recipe(profile)
    if profile != record_profile(promotion):
        raise SystemExit(f"Full training blocked: --model {profile} does not match the promoted canary profile "
                         f"{record_profile(promotion)}")
    if record_profile(record) != record_profile(promotion):
        raise SystemExit("Full training blocked: candidate canary profile changed after promotion; "
                         "promote the dataset again")
    ensure_vm()
    check_trainer_python()
    check_trainable(ROOT, PYTHON, record)
    pins = ensure_pinned()
    data = render_and_stage(record)
    if digest(Path(record["rendered_path"])) != promotion["rendered_sha256"]:
        raise SystemExit("Rendered dataset changed after promotion; promote the dataset again")
    train_id = new_id()
    training = {"train_id": train_id, "dataset_run_id": record["run_id"],
                "dataset_sha256": record["dataset_sha256"], "rendered_sha256": promotion["rendered_sha256"],
                "generation_git_commit": record["git_commit"], "config": record["config"], **pins,
                "profile": profile, "recipe": recipe,
                "output": f"{HOST}/lfm/runs/sayso-promotion/{train_id}-full",
                "started_at": datetime.now(timezone.utc).isoformat(), "trained": False}
    save_training(training)
    # The candidate pointer is left alone: a newer candidate stays current while this trains.
    record["trained"] = False
    save(STATE / f"{record['run_id']}.json", record)
    try:
        run([GPU_LOCK, "train", "lfm", TRAINER_PYTHON, f"{HOST_TRAINING}/training/scripts/sayso_trainer.py",
             "--data", data, *eval_data_args(record), "--out", training["output"],
             "--promotion-record", f"{HOST_TRAINING}/training/runs/promotion/promoted_dataset.json", *recipe])
    except BaseException:
        gpu("serve")
        raise
    manifest = local_output(training) / "manifest.json"
    training.update(trained=True, checkpoint=f"{training['output']}/final",
                    finished_at=datetime.now(timezone.utc).isoformat(),
                    manifest=load(manifest) if manifest.is_file() else None)
    save_training(training)
    record["trained"] = True
    save(STATE / f"{record['run_id']}.json", record)
    settle_gpu()
    print(f"Trained: {train_id}")
    if not getattr(args, "chained", False):
        print("Next: ./sayso select")


def cmd_select(args: argparse.Namespace) -> None:
    training = training_run(args)
    if not training.get("trained"):
        raise SystemExit("Checkpoint selection requires a completed full training run")
    ensure_vm()
    auto_eval(training)
    print("Next: ./sayso eval")


def export_release(training: dict, checkpoint: str) -> tuple[Path, str]:
    name = Path(checkpoint).name
    local = local_output(training) / "release"
    local.mkdir(parents=True, exist_ok=True)
    run(["docker", "exec", "-e", "CUDA_VISIBLE_DEVICES=", "-e", "HIP_VISIBLE_DEVICES=", "sayso-trainer", "python",
         CONVERTER, checkpoint, "--outfile", f"{training['output']}/release/{name}-F16.gguf", "--outtype", "f16"])
    gguf = local / f"{name}-{RELEASE_QUANT}.gguf"
    run([str(PYTHON), str(ROOT / "training/scripts/export_gguf.py"), str(local / f"{name}-F16.gguf"), str(gguf),
         "--quant", RELEASE_QUANT])
    return gguf, digest(gguf)


def cmd_eval(args: argparse.Namespace) -> None:
    """Release eval: export the selected checkpoint as the shipped GGUF and compare it with the champion."""
    training = training_run(args)
    checkpoint = training.get("selected_checkpoint")
    if not training.get("trained") or not checkpoint:
        raise SystemExit("Release eval requires a trained run with a selected checkpoint (./sayso select)")
    ensure_vm()
    training.update(release=None, final_metrics=None, final_eval_passed=False)
    save_training(training)
    champion = load(BASELINE)["eval"]["champion"]
    if digest(Path(champion["gguf"])) != champion["gguf_sha256"]:
        raise SystemExit(f"Champion GGUF does not match its recorded sha256: {champion['gguf']}")
    gguf, gguf_sha256 = export_release(training, checkpoint)
    candidate: dict[str, dict] = {}
    baseline: dict[str, dict] = {}
    context_passed = False
    for suite in RELEASE_SUITES:
        passed, summaries = eval_checkpoint(str(gguf), f"{training['train_id']}-release-{suite}", suite)
        candidate[suite] = suite_summary(summaries, suite)
        context_passed = passed if suite == "context" else context_passed
        _, summaries = eval_checkpoint(champion["gguf"], f"{training['train_id']}-champion-{suite}", suite)
        baseline[suite] = suite_summary(summaries, suite)
    comparison = compare_release({suite: outcomes(summary) for suite, summary in candidate.items()},
                                 {suite: outcomes(summary) for suite, summary in baseline.items()},
                                 context_passed=context_passed, safety=safety_flags())
    training.update(release={"checkpoint": checkpoint, "gguf": str(gguf), "gguf_sha256": gguf_sha256,
                             "quant": RELEASE_QUANT, "converter": CONVERTER,
                             "converter_sha256": digest(host_path(CONVERTER)),
                             "runtime": candidate["promotion"].get("runtime"),
                             "champion": {"name": champion["name"], "gguf_sha256": champion["gguf_sha256"]},
                             "comparison": comparison, "evaluated_at": datetime.now(timezone.utc).isoformat()},
                    final_metrics=candidate, final_eval_passed=comparison["passed"])
    save_training(training)
    for suite, row in comparison["suites"].items():
        print(f"{suite}: {row['candidate_passed']}/{row['total']} vs champion {row['champion_passed']}/{row['total']}"
              f" (+{len(row['wins'])} -{len(row['losses'])}, sign test p={row['sign_test_p']})")
    if comparison["failures"]:
        raise SystemExit("Release eval failed; model was not promoted:\n  " + "\n  ".join(comparison["failures"]))
    print(f"Release eval passed: {gguf} ({gguf_sha256})")


def cmd_promote_model(args: argparse.Namespace) -> None:
    training = training_run(args)
    release = training.get("release")
    if not training.get("trained") or not release or not training.get("final_metrics"):
        raise SystemExit("Model promotion requires a completed release evaluation (./sayso eval)")
    if args.manual_override and not (args.reason or "").strip():
        raise SystemExit("Manual model promotion requires a non-empty --reason")
    if digest(Path(release["gguf"])) != release["gguf_sha256"]:
        raise SystemExit("Release GGUF changed after it was evaluated; run ./sayso eval again")
    if not training.get("final_eval_passed") and not args.manual_override:
        raise SystemExit("Model promotion requires a passing final evaluation")
    promotion = {"promoted": True, "train_id": training.get("train_id"),
                 "dataset_run_id": training.get("dataset_run_id"), "checkpoint": release["checkpoint"],
                 "gguf": release["gguf"], "gguf_sha256": release["gguf_sha256"], "quant": release.get("quant"),
                 "dataset_sha256": training.get("dataset_sha256"), "git_commit": training.get("git_commit"),
                 "sayso_commit": training.get("sayso_commit"), "config": training.get("config"),
                 "eval_metrics": training["final_metrics"], "comparison": release.get("comparison"),
                 "final_eval_passed": bool(training.get("final_eval_passed")),
                 "promoted_at": datetime.now(timezone.utc).isoformat()}
    if args.manual_override:
        promotion.update(promotion_mode="manual_override", manual_override_reason=args.reason.strip())
    save(STATE / "promoted_model.json", promotion)
    print(f"Promoted model: {release['gguf']} ({release['gguf_sha256']})")


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def load_run() -> dict | None:
    path = STATE / "run.json"
    return load(path) if path.is_file() else None


def save_run(state: dict) -> None:
    state["updated_at"] = utc_now().isoformat()
    save(STATE / "run.json", state)


def training_record(train_id: str | None) -> dict:
    path = TRAINS / f"{train_id}.json" if train_id else None
    return load(path) if path and path.is_file() else {}


def append_ledger(entry: dict) -> None:
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as ledger:
        ledger.write(json.dumps(entry) + "\n")


def ledger_entry(state: dict, verdict: str) -> dict:
    training = training_record(state.get("train_id"))
    suites = ((training.get("release") or {}).get("comparison") or {}).get("suites", {})
    return {"run_key": state["run_key"], "finished_at": utc_now().isoformat(), "model": state["model"],
            "hypothesis": state["hypothesis"], "config": state["config"],
            "dataset_run_id": state.get("dataset_run_id"), "train_id": state.get("train_id"),
            "git_commit": training.get("git_commit"), "auto_eval": training.get("auto_eval"),
            "selected_checkpoint": training.get("selected_checkpoint"),
            "release_comparison": {suite: {key: row[key] for key in ("candidate_passed", "champion_passed", "total")}
                                   for suite, row in suites.items()},
            "failure": state.get("failure"), "verdict": verdict}


def promote_dataset_stage(state: dict) -> None:
    cmd_promote_dataset(argparse.Namespace())
    state["dataset_run_id"] = load(STATE / "promoted_dataset.json")["run_id"]


def train_stage(state: dict) -> None:
    cmd_train(argparse.Namespace(model=state["model"], chained=True))
    state["train_id"] = load(STATE / "latest_train.json")["train_id"]


def eval_stage(state: dict) -> None:
    started = utc_now()
    try:
        cmd_eval(argparse.Namespace(train_id=state["train_id"]))
    except SystemExit:
        evaluated = (training_record(state["train_id"]).get("release") or {}).get("evaluated_at")
        if not evaluated or datetime.fromisoformat(evaluated) < started:
            raise


def queue_stage(state: dict) -> None:
    training = training_record(state["train_id"])
    if not training.get("final_eval_passed"):
        state["verdict"] = "not_promotable"
        return
    release = training["release"]
    save(STATE / "promotion_queue" / f"{state['train_id']}.json", {
        "train_id": state["train_id"], "run_key": state["run_key"], "dataset_run_id": state["dataset_run_id"],
        "profile": state["model"], "hypothesis": state["hypothesis"], "checkpoint": training["selected_checkpoint"],
        "gguf": release["gguf"], "gguf_sha256": release["gguf_sha256"], "comparison": release["comparison"],
        "queued_at": utc_now().isoformat()})
    state["verdict"] = "queued"


def stage_plan() -> list[tuple[str, object]]:
    return [
        ("generate", lambda state: cmd_generate(argparse.Namespace(config=state["config"],
                                                                   accept_drift=state["accept_drift"]))),
        ("validate", lambda state: cmd_validate(argparse.Namespace())),
        ("canary", lambda state: cmd_canary(argparse.Namespace(model=state["model"], reuse_checkpoint=False))),
        ("promote-dataset", promote_dataset_stage),
        ("train", train_stage),
        ("select", lambda state: cmd_select(argparse.Namespace(train_id=state["train_id"]))),
        ("eval", eval_stage),
        ("queue", queue_stage),
    ]


def run_stage(state: dict, name: str, action) -> None:
    state.update(stage=name, failure=None)
    save_run(state)
    print(f"== {name} ==", flush=True)
    try:
        action(state)
    except (Exception, SystemExit) as exc:
        state["failure"] = {"stage": name, "reason": str(exc)}
        save_run(state)
        try:
            gpu("serve")
        except Exception:
            pass
        append_ledger(ledger_entry(state, "failed"))
        raise
    state["stages_done"].append(name)
    save_run(state)


def new_run(args: argparse.Namespace) -> dict:
    hypothesis = (args.hypothesis or "").strip()
    if not hypothesis:
        raise SystemExit("./sayso run needs a non-empty --hypothesis")
    if not args.model:
        raise SystemExit("./sayso run needs --model <profile>")
    model_profile(args.model)
    if args.accept_drift is not None and not args.accept_drift.strip():
        raise SystemExit("--accept-drift requires a non-empty reason")
    previous = load_run()
    if previous and previous["stage"] != "finished":
        raise SystemExit(f"Run {previous['run_key']} is unfinished at stage {previous['stage']}; "
                         "continue it with ./sayso run --resume")
    state = {"run_key": new_id(), "model": args.model, "hypothesis": hypothesis, "config": args.config,
             "accept_drift": args.accept_drift, "stage": None, "stages_done": [], "dataset_run_id": None,
             "train_id": None, "verdict": None, "failure": None, "started_at": utc_now().isoformat()}
    save_run(state)
    return state


def resume_run() -> dict:
    state = load_run()
    if state is None:
        raise SystemExit("No run to resume; start one with ./sayso run --model <profile> --hypothesis <text>")
    if state["stage"] == "finished":
        raise SystemExit(f"Run {state['run_key']} already finished ({state['verdict']}); nothing to resume")
    return state


def cmd_run(args: argparse.Namespace) -> None:
    state = resume_run() if args.resume else new_run(args)
    for name, action in stage_plan():
        if name not in state["stages_done"]:
            run_stage(state, name, action)
    state["stage"] = "finished"
    save_run(state)
    append_ledger(ledger_entry(state, state["verdict"]))
    print(f"Run {state['run_key']}: {state['verdict']}")


def training_progress(train_id: str | None) -> dict | None:
    path = TRAINS / f"{train_id}.json" if train_id else None
    if path is None or not path.is_file():
        return None
    training = load(path)
    directory = local_output(training)
    steps = [step(checkpoint.name) for checkpoint in directory.glob("checkpoint-*")
             if checkpoint.name.rsplit("-", 1)[-1].isdigit()]
    manifest = directory / "manifest.json"
    schedule = load(manifest) if manifest.is_file() else (training.get("manifest") or {})
    return {"train_id": train_id, "step": max(steps, default=None), "max_steps": schedule.get("max_steps")}


def next_command(run: dict) -> str | None:
    if not run:
        return None
    if run.get("failure") or run.get("stage") != "finished":
        return "./sayso run --resume"
    if run.get("verdict") == "queued":
        return f"./sayso promote-model --train-id {run['train_id']}"
    return None


def cmd_status(args: argparse.Namespace) -> None:
    run = load_run() or {}
    status = {"run": run, "training_progress": training_progress(run.get("train_id")),
              "queued_promotions": sorted(path.stem for path in (STATE / "promotion_queue").glob("*.json")),
              "next_command": next_command(run)}
    print(json.dumps(status) if args.json else json.dumps(status, indent=2))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    for name, handler in (("generate", cmd_generate), ("validate", cmd_validate), ("canary", cmd_canary),
                          ("promote-dataset", cmd_promote_dataset), ("train", cmd_train), ("select", cmd_select),
                          ("eval", cmd_eval), ("promote-model", cmd_promote_model)):
        command = sub.add_parser(name)
        if name == "generate":
            command.add_argument("--config", default=GENERATION_CONFIG, help="generation recipe path")
            command.add_argument("--accept-drift", metavar="REASON", help="accept golden drift with an audit reason")
        if name in {"select", "eval", "promote-model"}:
            command.add_argument("--train-id", help="training run to act on (default: the latest ./sayso train)")
        if name in {"canary", "train"}:
            command.add_argument("--model", default=DEFAULT_MODEL,
                                 help="model profile from training/configs/models.yaml")
        if name == "canary":
            command.add_argument("--reuse-checkpoint", action="store_true",
                                 help="skip canary training and evaluate the existing checkpoint")
        if name == "promote-model":
            command.add_argument("--manual-override", action="store_true",
                                 help="promote an evaluated model whose final gates failed")
            command.add_argument("--reason", help="required audit note for a manual override")
    run_parser = sub.add_parser("run")
    run_parser.add_argument("--model", help="model profile from training/configs/models.yaml")
    run_parser.add_argument("--hypothesis", help="what this run is expected to improve")
    run_parser.add_argument("--config", default=GENERATION_CONFIG, help="generation recipe path")
    run_parser.add_argument("--accept-drift", metavar="REASON", help="accept golden drift with an audit reason")
    run_parser.add_argument("--resume", action="store_true", help="continue the unfinished run in run.json")
    status_parser = sub.add_parser("status")
    status_parser.add_argument("--json", action="store_true", help="print one compact JSON object")
    args = parser.parse_args()
    {"generate": cmd_generate, "validate": cmd_validate, "canary": cmd_canary,
     "promote-dataset": cmd_promote_dataset, "train": cmd_train, "select": cmd_select,
     "eval": cmd_eval, "promote-model": cmd_promote_model, "run": cmd_run, "status": cmd_status}[args.command](args)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode or 1)
