+_EXTRA_PRONUNCIATIONS: dict[str, list[str]] = {}
+
+
+def register_pronunciations(pronunciations: dict[str, str]) -> None:
+    """Add config ``pronunciations`` (word -> ARPAbet) on top of CMUDict."""
+    _EXTRA_PRONUNCIATIONS.update({w.lower(): arpa.split() for w, arpa in pronunciations.items()})
+
+
+def get_cmudict() -> dict[str, list[str]]:
+    if not _EXTRA_PRONUNCIATIONS:
+        return _base_cmudict()
+    return {**_base_cmudict(), **_EXTRA_PRONUNCIATIONS}
